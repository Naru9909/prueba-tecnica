APP_NAME="Blog Prueba Técnica"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =========================================================================
# BASE DE DATOS
# =========================================================================
# PREGUNTA: ¿Por qué se usa DB_CONNECTION=mysql en lugar de sqlite para este proyecto?
# ¿Qué ventajas y desventajas tiene cada driver para desarrollo?
#
# Configura aquí tu conexión MySQL local.
# Asegúrate de crear la base de datos antes de correr las migraciones:
#   CREATE DATABASE blog_prueba CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# =========================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blog_prueba
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# =========================================================================
# CACHÉ
# =========================================================================
# PREGUNTA: ¿Qué driver de caché usarías en producción?
# ¿Qué diferencia hay entre 'file', 'database', 'redis' y 'memcached'?
# ¿Por qué usamos 'file' aquí para desarrollo?
# =========================================================================
CACHE_STORE=file
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@blog-prueba.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
